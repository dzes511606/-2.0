<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>餐飲商模戰情室 V2</title>
<style>
:root{color-scheme:light dark;--bg:light-dark(#f4f6f8,#111518);--surface:light-dark(#fff,#191e21);--surface2:light-dark(#f8fafb,#20272b);--text:light-dark(#182126,#f2f5f6);--muted:light-dark(#68757c,#a9b5ba);--border:light-dark(#e0e6e9,#30393e);--accent:light-dark(#176b5d,#63c7b1);--accent2:light-dark(#e8f5f1,#18352f);--warn:light-dark(#9a5b00,#e3a64d);--danger:light-dark(#a13b35,#e98279)}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans TC",sans-serif;background:var(--bg);color:var(--text)}#app{min-height:100vh;background:var(--bg)}button,input,select{font:inherit}button{cursor:pointer}.top{padding:28px max(22px,calc((100vw - 1180px)/2)) 16px;display:flex;justify-content:space-between;gap:20px;align-items:end}.eyebrow{font-size:12px;letter-spacing:.12em;color:var(--accent);font-weight:800}.top h1{margin:5px 0 4px;font-size:28px}.top p{margin:0;color:var(--muted);font-size:14px}.mode{border:1px solid var(--border);background:var(--surface);padding:8px;border-radius:12px;display:flex;gap:5px}.mode button{border:0;background:transparent;color:var(--muted);padding:8px 13px;border-radius:8px}.mode button.active{background:var(--accent);color:#fff}.wrap{max-width:1180px;margin:auto;padding:0 22px 110px}.nav{display:flex;gap:4px;border-bottom:1px solid var(--border);margin-bottom:20px}.nav button{border:0;background:transparent;color:var(--muted);padding:13px 16px;border-bottom:2px solid transparent}.nav button.active{color:var(--text);border-bottom-color:var(--accent);font-weight:700}.grid{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}.card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:20px}.card h2{font-size:17px;margin:0 0 5px}.card h3{font-size:14px;margin:20px 0 10px}.sub{font-size:13px;color:var(--muted);margin-bottom:16px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field label{display:block;font-size:12px;font-weight:700;margin-bottom:6px}.field input,.field select{width:100%;border:1px solid var(--border);background:var(--surface2);color:var(--text);border-radius:9px;padding:10px 11px;outline:none}.field input:focus,.field select:focus{border-color:var(--accent)}.full{grid-column:1/-1}.choices{display:flex;gap:8px;flex-wrap:wrap}.choice{border:1px solid var(--border);background:var(--surface2);color:var(--text);border-radius:9px;padding:10px 14px}.choice.active{border-color:var(--accent);background:var(--accent2);color:var(--accent);font-weight:800}.result{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}.metric{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:13px}.metric small{display:block;color:var(--muted);font-size:11px}.metric strong{display:block;font-size:20px;margin-top:5px}.hero{background:var(--accent2);border:1px solid color-mix(in srgb,var(--accent) 30%,var(--border));border-radius:16px;padding:18px}.hero .big{font-size:34px;font-weight:850;margin:5px 0}.pill{display:inline-flex;border-radius:999px;padding:5px 9px;font-size:11px;background:var(--surface);color:var(--muted);border:1px solid var(--border)}.section{margin-top:18px}.bar{height:9px;background:var(--surface2);border-radius:999px;overflow:hidden}.bar i{display:block;height:100%;background:var(--accent);border-radius:999px}.costrow{display:grid;grid-template-columns:1fr auto;gap:12px;padding:9px 0;border-bottom:1px solid var(--border);font-size:13px}.costrow span:last-child{font-weight:700}.target{display:grid;grid-template-columns:1fr 1fr;gap:14px}.target .field{background:var(--surface2);padding:13px;border-radius:12px}.target .field input{background:var(--surface)}.scenario{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.scenario button{text-align:left;border:1px solid var(--border);background:var(--surface);border-radius:14px;padding:15px;color:var(--text)}.scenario button:hover{border-color:var(--accent)}.scenario strong{display:block;margin-bottom:4px}.notice{padding:12px 14px;border-radius:11px;background:light-dark(#fff7e8,#332718);border:1px solid color-mix(in srgb,var(--warn) 35%,var(--border));color:var(--warn);font-size:13px}.positive{color:var(--accent)}.negative{color:var(--danger)}.sticky{position:fixed;left:0;right:0;bottom:0;background:color-mix(in srgb,var(--surface) 94%,transparent);backdrop-filter:blur(12px);border-top:1px solid var(--border);padding:12px max(22px,calc((100vw - 1180px)/2));display:flex;justify-content:space-between;gap:18px;align-items:center}.sticky .summary{display:flex;gap:24px}.sticky small{display:block;color:var(--muted);font-size:10px}.sticky strong{font-size:16px}.hide{display:none!important}.mode-note{font-size:12px;color:var(--muted);margin-top:8px}.tag{font-size:11px;padding:4px 7px;border-radius:6px;background:var(--accent2);color:var(--accent)}
.chartgrid{display:grid;grid-template-columns:1.2fr .8fr;gap:18px}.waterfall{display:flex;align-items:flex-end;gap:10px;height:210px;padding:16px 4px 28px;border-bottom:1px solid var(--border)}.wf{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;font-size:11px;color:var(--muted)}.wf i{display:block;width:72%;min-height:4px;background:var(--accent);border-radius:5px 5px 0 0}.wf.neg i{background:var(--danger)}.wf strong{font-size:11px;color:var(--text);margin-bottom:5px}.pie{width:190px;height:190px;border-radius:50%;margin:8px auto 14px;background:conic-gradient(var(--accent) 0 35%,#4d7c73 35% 55%,#d39a4c 55% 72%,#8d6660 72% 88%,#82919a 88% 100%);position:relative}.pie:after{content:"";position:absolute;inset:43px;background:var(--surface);border-radius:50%}.legend{display:grid;gap:7px;font-size:12px}.legend span{display:flex;justify-content:space-between}.probox{border:1px dashed var(--accent);background:var(--accent2);padding:14px;border-radius:12px}.pct{color:var(--muted);font-size:12px;margin-left:8px;font-weight:600}
@media(max-width:800px){.grid,.target{grid-template-columns:1fr}.fields{grid-template-columns:1fr}.scenario{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}.sticky{align-items:flex-start;overflow:auto}.sticky .summary{gap:15px;min-width:max-content}}
</style>
</head>
<body>
<div id="app">
<header class="top"><div><div class="eyebrow">RESTAURANT BUSINESS BATTLE ROOM · V2</div><h1>餐飲商模戰情室</h1><p>先估算這家店正常能做到多少，再模擬「如果我要達成……」</p></div><div class="mode"><button class="active" data-mode="general">一般模式</button><button data-mode="professional">專業模式</button></div></header>
<main class="wrap">
<nav class="nav"><button class="active" data-tab="setup">店舖模型</button><button data-tab="target">目標模擬</button><button data-tab="repair">營收修復</button><button data-tab="marketing">行銷投資</button></nav>
<section id="setup" class="tab">
<div class="grid">
<div class="card"><h2>① 店舖基本條件</h2><div class="sub">填入第一次使用時通常知道的資料；翻桌率與目前營收不需要自己猜。</div>
<div class="fields">
<div class="field"><label>餐飲類型</label><select id="type"><option>火鍋</option><option>燒肉</option><option>中式餐廳</option><option>餐酒館</option><option>咖啡／甜點</option><option>其他</option></select></div>
<div class="field"><label>座位數</label><input id="seats" type="number" value="60" min="1"></div>
<div class="field"><label>營業開始</label><input id="open" type="time" value="11:00"></div><div class="field"><label>營業結束</label><input id="close" type="time" value="21:30"></div>
<div class="field"><label>平日營業天數／月</label><input id="weekdays" type="number" value="22" min="0"></div><div class="field"><label>假日營業天數／月</label><input id="weekends" type="number" value="8" min="0"></div>
<div class="field full"><label>營業餐期</label><div class="choices"><button class="choice active" data-meal="lunch">午餐</button><button class="choice active" data-meal="dinner">晚餐</button><button class="choice" data-meal="other">其他時段</button></div></div>
<div class="field full"><label>平均用餐時間 <span class="pct">以 5 分鐘為單位</span></label><input id="durationInput" type="number" value="60" min="5" step="5"></div>
<div class="field full"><label>平日容量條件 <span class="pct">翻桌率＝每小時翻桌次數</span></label><div class="fields"><div class="field"><label>尖峰時段／日（小時）</label><input id="wdPeakHours" type="number" value="4" min="0" step="0.5"></div><div class="field"><label>尖峰翻桌率／時</label><input id="wdPeakTurn" type="number" value="1.5" min="0" step="0.1"></div><div class="field"><label>尖峰滿桌率</label><input id="wdPeakFill" type="number" value="85" min="0" max="100"></div><div class="field"><label>離峰時段／日（小時）</label><input id="wdOffHours" type="number" value="6.5" min="0" step="0.5"></div><div class="field"><label>離峰翻桌率／時</label><input id="wdOffTurn" type="number" value="0.6" min="0" step="0.1"></div><div class="field"><label>離峰滿桌率</label><input id="wdOffFill" type="number" value="55" min="0" max="100"></div></div></div>
<div class="field full"><label>假日容量條件 <span class="pct">可依實際營業型態調整</span></label><div class="fields"><div class="field"><label>尖峰時段／日（小時）</label><input id="wePeakHours" type="number" value="5" min="0" step="0.5"></div><div class="field"><label>尖峰翻桌率／時</label><input id="wePeakTurn" type="number" value="2.5" min="0" step="0.1"></div><div class="field"><label>尖峰滿桌率</label><input id="wePeakFill" type="number" value="90" min="0" max="100"></div><div class="field"><label>離峰時段／日（小時）</label><input id="weOffHours" type="number" value="5.5" min="0" step="0.5"></div><div class="field"><label>離峰翻桌率／時</label><input id="weOffTurn" type="number" value="0.8" min="0" step="0.1"></div><div class="field"><label>離峰滿桌率</label><input id="weOffFill" type="number" value="60" min="0" max="100"></div></div></div>
<div class="field full"><label>平均客單</label><input id="ticket" type="number" value="500" min="1"></div>
</div></div>
<div class="card"><h2>② 成本條件</h2><div class="sub">不知道食材成本率時，先用估算值；之後有實際資料再覆蓋。</div>
<h3>食材成本率</h3><div class="choices"><button class="choice" data-food="30">30%</button><button class="choice active" data-food="35">35%</button><button class="choice" data-food="40">40%</button><button class="choice" data-food="custom">自訂</button></div><div class="field section hide" id="foodCustom"><input id="foodRate" type="number" value="35" min="0" max="100"></div>
<h3>人事成本</h3><div class="fields"><div class="field"><label>正職人數</label><input id="fulltime" type="number" value="8" min="0"></div><div class="field"><label>正職平均月薪</label><input id="fullsalary" type="number" value="35000" min="0"></div><div class="field"><label>PT 月總工時</label><input id="ptHours" type="number" value="600" min="0"></div><div class="field"><label>PT 時薪 <span class="pct">預設最低工資 196 元</span></label><input id="ptRate" type="number" value="196" min="0"></div><div class="field"><label>店主管人數</label><input id="manager" type="number" value="1" min="0"></div><div class="field"><label>主管平均月薪</label><input id="managersalary" type="number" value="45000" min="0"></div></div>
<h3>其他成本</h3><div class="fields"><div class="field"><label>月租金</label><input id="rent" type="number" value="120000" min="0"></div><div class="field"><label>水電瓦斯／月</label><input id="utilities" type="number" value="100000" min="0"></div><div class="field full"><label>其他營運成本／月</label><input id="other" type="number" value="80000" min="0"></div></div>
</div></div>
<div class="card section"><h2>③ 模型結果</h2><div class="sub">容量改用平日／假日 × 尖峰／離峰的「時數 × 翻桌率 × 滿桌率」估算，平均用餐時間仍可作為合理性檢核。</div><div class="result"><div class="metric"><small>理論容量／月</small><strong id="capacity">—</strong></div><div class="metric"><small>模型預估來客／月</small><strong id="customers">—</strong></div><div class="metric"><small>預估月營收</small><strong id="revenue">—</strong></div></div><div class="section"><div style="display:flex;justify-content:space-between;font-size:12px"><span>模型容量利用率</span><b id="utilization">—</b></div><div class="bar"><i id="utilBar" style="width:0%"></i></div></div><div class="result"><div class="metric"><small>預估日均來客</small><strong id="dailyCustomers">—</strong></div><div class="metric"><small>預估日營收</small><strong id="dailyRevenue">—</strong></div><div class="metric"><small>人事成本率</small><strong id="laborRate">—</strong></div></div></div>
<div class="card section"><h2>④ 月損益</h2><div class="costrow"><span>營收</span><span id="pRevenue">—</span></div><div class="costrow"><span>食材成本 <span class="pct" id="pFoodPct">—</span></span><span id="pFood">—</span></div><div class="costrow"><span>毛利 <span class="pct" id="pGrossPct">—</span></span><span id="pGross">—</span></div><div class="costrow"><span>人事成本 <span class="pct" id="pLaborPct">—</span></span><span id="pLabor">—</span></div><div class="costrow"><span>租金 <span class="pct" id="pRentPct">—</span></span><span id="pRent">—</span></div><div class="costrow"><span>水電瓦斯 <span class="pct" id="pUtilitiesPct">—</span></span><span id="pUtilities">—</span></div><div class="costrow"><span>其他營運成本 <span class="pct" id="pOtherPct">—</span></span><span id="pOther">—</span></div><div class="costrow"><span><b>營業利益</b> <span class="pct" id="pProfitPct">—</span></span><span id="pProfit">—</span></div><div class="costrow"><span><b>模型淨利（未含折舊／利息／所得稅）</b> <span class="pct" id="pNetPct">—</span></span><span id="pNet">—</span></div><div class="result"><div class="metric"><small>毛利率</small><strong id="grossMargin">—</strong></div><div class="metric"><small>營業利益率</small><strong id="margin">—</strong></div><div class="metric"><small>BEP 月來客</small><strong id="bepCustomers">—</strong></div><div class="metric"><small>BEP 日均來客</small><strong id="bepDaily">—</strong></div></div></div>
<div class="card section"><h2>⑤ 圖表化損益</h2><div class="chartgrid"><div><h3>月損益瀑布</h3><div class="waterfall" id="waterfall"></div></div><div><h3>成本結構</h3><div class="pie" id="costPie"></div><div class="legend" id="costLegend"></div></div></div></div>
<div class="card section hide" id="proPanel"><h2>專業模式：實際營運資料</h2><div class="sub">專業模式改用店內實際數據，不再由容量模型推估；POS 匯入可在下一版接 Excel／CSV。</div><div class="probox"><div class="fields"><div class="field"><label>實際月營收</label><input id="actualRevenue" type="number" value="2600000" min="0"></div><div class="field"><label>實際月來客</label><input id="actualCustomers" type="number" value="5000" min="0"></div><div class="field"><label>實際食材成本率</label><input id="actualFoodRate" type="number" value="35" min="0" max="100"></div><div class="field"><label>實際人事成本</label><input id="actualLabor" type="number" value="400000" min="0"></div></div></div></div>
</section>
<section id="target" class="tab hide"><div class="card"><h2>如果我要達成……</h2><div class="sub">先輸入「目標營收」與「平均客單」，系統只把兩條可行路徑拆開：增加來客，或提高客單。</div><div class="target"><div class="field"><label>目標營收／月</label><input id="targetRevenue" type="number" value="3000000" min="0"></div><div class="field"><label>平均客單</label><input id="targetTicket" type="number" value="500" min="1"></div><div class="field"><label>目前模型來客</label><div id="currentCustomerBox" style="font-size:22px;font-weight:800;padding:8px 0">—</div></div><div class="field"><label>模型合理容量</label><div id="modelCapacityBox" style="font-size:22px;font-weight:800;padding:8px 0">—</div></div></div><div class="result"><div class="metric"><small>目標需要來客</small><strong id="needCustomers">—</strong></div><div class="metric"><small>A｜需要增加來客</small><strong id="addCustomers">—</strong></div><div class="metric"><small>B｜若維持目前來客，需要客單</small><strong id="needTicket">—</strong></div></div><div id="targetNotice" class="notice section">—</div></div></section>
<section id="repair" class="tab hide"><div class="card"><h2>營收修復</h2><div class="sub">把「目標落差」轉成可計算的行動情境，不直接替你決定策略。</div><div class="hero"><span class="pill">目前模型</span><div class="big" id="repairRevenue">—</div><div>目標營收 <b id="repairTarget">—</b>　·　目標落差 <b id="repairGap">—</b></div></div><div class="section"><h3>選擇模擬方式</h3><div class="scenario"><button data-scenario="baseline"><strong>維持現況</strong><span class="sub">不增加投入，作為 Baseline。</span></button><button data-scenario="promo"><strong>短期促銷</strong><span class="sub">模擬活動成本與新增客。</span></button><button data-scenario="marketing"><strong>行銷投資</strong><span class="sub">模擬預算、客流與損益平衡。</span></button></div></div><div class="section" id="scenarioPanel"></div></div></section>
<section id="marketing" class="tab hide"><div class="card"><h2>行銷投資模擬</h2><div class="sub">新增客不是只有食材成本；先拆「每位新增客的變動成本」與「這次專案額外固定投入」，再看增量貢獻。</div><div class="fields"><div class="field"><label>行銷／活動投入</label><input id="mSpend" type="number" value="100000" min="0"></div><div class="field"><label>預估新增客</label><input id="mCustomers" type="number" value="300" min="0"></div><div class="field"><label>平均客單</label><input id="mTicket" type="number" value="500" min="1"></div><div class="field"><label>每位新增客變動成本率</label><input id="mVarRate" type="number" value="45" min="0" max="100"><span class="pct">食材＋支付／耗材／服務等增量成本</span></div><div class="field"><label>額外人力／加班成本</label><input id="mLaborExtra" type="number" value="0" min="0"></div><div class="field"><label>其他專案成本</label><input id="mOtherExtra" type="number" value="0" min="0"></div></div><div class="result"><div class="metric"><small>新增營收</small><strong id="mRevenue">—</strong></div><div class="metric"><small>新增變動成本</small><strong id="mVariable">—</strong></div><div class="metric"><small>專案總投入</small><strong id="mTotalSpend">—</strong></div><div class="metric"><small>增量營業利益</small><strong id="mProfit">—</strong></div><div class="metric"><small>損益平衡新增客</small><strong id="mBep">—</strong></div></div><div id="mNotice" class="notice section">—</div></div><div class="card section"><h2>進階：行銷專案紀錄</h2><div class="sub">之後可累積「預估 vs 實際」，並依短／中／長期目標觀察，不用單次專案直接判定哪個渠道最好。</div><div class="costrow"><span>短期營收刺激</span><span class="tag">新增客／營收</span></div><div class="costrow"><span>中期會員／回流</span><span class="tag">回流／會員</span></div><div class="costrow"><span>長期品牌</span><span class="tag">不強制當月新增客</span></div></div></section>
</main>
<div class="sticky"><div class="summary"><div><small>月營收</small><strong id="stickyRevenue">—</strong></div><div><small>BEP 日均來客</small><strong id="stickyBep">—</strong></div><div><small>營業利益</small><strong id="stickyProfit">—</strong></div></div><div class="tag">模型即時更新</div></div>
</div>
<script>
const $=id=>document.getElementById(id); const money=n=>new Intl.NumberFormat('zh-TW',{style:'currency',currency:'TWD',maximumFractionDigits:0}).format(Math.round(n||0)); const num=n=>new Intl.NumberFormat('zh-TW',{maximumFractionDigits:0}).format(Math.round(n||0)); const pct=n=>(n||0).toFixed(1)+'%';
let foodRate=35,duration=60,meals={lunch:true,dinner:true,other:false},mode='general'; let state={customers:0,revenue:0,food:0,labor:0,rent:0,utilities:0,other:0,profit:0,bep:0,ticket:500,capacity:0};
function val(id){const e=$(id);return e?Number(e.value)||0:0} function valTime(id){const e=$(id);if(!e||!e.value)return 0;const [h,m]=e.value.split(':').map(Number);return h*60+m}
function modelCapacity(){const seats=val('seats'),wd=val('weekdays'),we=val('weekends'),maxTurn=60/Math.max(5,duration); const wdPeak=Math.min(val('wdPeakTurn'),maxTurn),wdOff=Math.min(val('wdOffTurn'),maxTurn),wePeak=Math.min(val('wePeakTurn'),maxTurn),weOff=Math.min(val('weOffTurn'),maxTurn); const wdDaily=seats*(val('wdPeakHours')*wdPeak*val('wdPeakFill')/100+val('wdOffHours')*wdOff*val('wdOffFill')/100); const weDaily=seats*(val('wePeakHours')*wePeak*val('wePeakFill')/100+val('weOffHours')*weOff*val('weOffFill')/100); return {wdDaily,weDaily,capacity:Math.round(wdDaily*wd+weDaily*we),daily:Math.round((wdDaily*wd+weDaily*we)/Math.max(1,wd+we))}}
function calc(){const m=modelCapacity(),wd=val('weekdays'),we=val('weekends'),ticket=val('ticket')||500; duration=Math.max(5,Math.round(val('durationInput')/5)*5); const theoretical=m.capacity; let customers=Math.round(m.wdDaily*wd+m.weDaily*we); if(mode==='professional')customers=val('actualCustomers'); let revenue=mode==='professional'?val('actualRevenue'):customers*ticket; const labor=mode==='professional'?val('actualLabor'):val('fulltime')*val('fullsalary')+val('ptHours')*val('ptRate')+val('manager')*val('managersalary'); const effectiveFood=mode==='professional'?val('actualFoodRate'):foodRate; const food=revenue*effectiveFood/100; const rent=val('rent'),utilities=val('utilities'),other=val('other'),gross=revenue-food,profit=gross-labor-rent-utilities-other; const fixed=labor+rent+utilities+other; const bep=Math.ceil(fixed/Math.max(.01,1-effectiveFood/100)/Math.max(1,ticket)); state={customers,revenue,food,labor,rent,utilities,other,profit,bep,ticket,capacity:theoretical,gross,effectiveFood}; const utilization=theoretical?customers/theoretical:0; $('capacity').textContent=num(theoretical); $('customers').textContent=num(customers); $('revenue').textContent=money(revenue); $('dailyCustomers').textContent=num(customers/Math.max(1,wd+we)); $('dailyRevenue').textContent=money(revenue/Math.max(1,wd+we)); $('utilization').textContent=pct(utilization*100); $('utilBar').style.width=Math.min(100,utilization*100)+'%'; $('laborRate').textContent=pct(revenue?labor/revenue*100:0); $('pRevenue').textContent=money(revenue); $('pFood').textContent=money(food); $('pFoodPct').textContent=pct(revenue?food/revenue*100:0); $('pGross').textContent=money(gross); $('pGrossPct').textContent=pct(revenue?gross/revenue*100:0); $('pLabor').textContent=money(labor); $('pLaborPct').textContent=pct(revenue?labor/revenue*100:0); $('pRent').textContent=money(rent); $('pRentPct').textContent=pct(revenue?rent/revenue*100:0); $('pUtilities').textContent=money(utilities); $('pUtilitiesPct').textContent=pct(revenue?utilities/revenue*100:0); $('pOther').textContent=money(other); $('pOtherPct').textContent=pct(revenue?other/revenue*100:0); $('pProfit').textContent=money(profit); $('pProfitPct').textContent=pct(revenue?profit/revenue*100:0); $('pNet').textContent=money(profit); $('pNetPct').textContent=pct(revenue?profit/revenue*100:0); $('grossMargin').textContent=pct(revenue?gross/revenue*100:0); $('margin').textContent=pct(revenue?profit/revenue*100:0); $('bepCustomers').textContent=num(bep); $('bepDaily').textContent=num(bep/Math.max(1,wd+we)); $('stickyRevenue').textContent=money(revenue); $('stickyBep').textContent=num(bep/Math.max(1,wd+we)); $('stickyProfit').textContent=money(profit); drawCharts(); updateTarget(); updateMarketing(); updateRepair()}
function drawCharts(){const items=[['營收',state.revenue],['食材',-state.food],['人事',-state.labor],['租金',-state.rent],['水電',-state.utilities],['其他',-state.other],['營業利益',state.profit]]; $('waterfall').innerHTML=items.map(x=>'<div class="wf '+(x[1]<0?'neg':'')+'"><strong>'+money(x[1])+'</strong><i style="height:'+Math.max(4,Math.min(150,Math.abs(x[1])/(Math.max(1,state.revenue))*150))+'px"></i><span>'+x[0]+'</span></div>').join(''); const costs=[['食材',state.food],['人事',state.labor],['租金',state.rent],['水電',state.utilities],['其他',state.other]]; const total=costs.reduce((a,b)=>a+b[1],0); const seg=costs.map(x=>Math.max(0,x[1]/Math.max(1,total))*100); let acc=0; $('costPie').style.background='conic-gradient('+seg.map((v,i)=>{const s=acc;acc+=v;return ['var(--accent)','#4d7c73','#d39a4c','#8d6660','#82919a'][i]+' '+s+'% '+acc+'%'}).join(',')+')'; $('costLegend').innerHTML=costs.map(x=>'<span><span>'+x[0]+'</span><b>'+money(x[1])+' · '+pct(total?x[1]/total*100:0)+'</b></span>').join('')}
function updateTarget(){const tr=val('targetRevenue'),tt=val('targetTicket')||state.ticket,current=state.customers,need=Math.ceil(tr/tt),add=need-current,needTicket=current?tr/current:0;$('currentCustomerBox').textContent=num(current)+' 人／月';$('modelCapacityBox').textContent=num(state.capacity)+' 人／月';$('needCustomers').textContent=num(need)+' 人';$('addCustomers').textContent=(add>=0?'+':'')+num(add)+' 人';$('needTicket').textContent=money(needTicket);$('targetNotice').textContent=need<=state.capacity?'A：增加來客 → 還需 '+num(Math.max(0,add))+' 人／月。 B：提升客單 → 若維持目前來客，客單需達 '+money(needTicket)+'。':'⚠️ 目標需要來客高於模型容量，應優先檢查尖峰時數、翻桌率、滿桌率與營業時段設定。'}
function updateRepair(){const tr=val('targetRevenue');$('repairRevenue').textContent=money(state.revenue);$('repairTarget').textContent=money(tr);$('repairGap').textContent=money(tr-state.revenue)}
function updateMarketing(){const spend=val('mSpend'),cust=val('mCustomers'),ticket=val('mTicket')||state.ticket,vr=val('mVarRate')/100,extra=val('mLaborExtra')+val('mOtherExtra'),rev=cust*ticket,variable=rev*vr,totalSpend=spend+extra,profit=rev-variable-totalSpend,contribution=ticket*(1-vr),bep=Math.ceil(totalSpend/Math.max(1,contribution));$('mRevenue').textContent=money(rev);$('mVariable').textContent=money(variable);$('mTotalSpend').textContent=money(totalSpend);$('mProfit').textContent=money(profit);$('mProfit').querySelector('strong').className=profit>=0?'positive':'negative';$('mBep').textContent=num(bep)+' 人';$('mNotice').textContent=cust>=bep?'目前假設下，新增客已覆蓋專案總投入。':'目前假設下，還需要約 '+num(bep-cust)+' 位新增客才能損益平衡。'}
function scenario(type){const panel=$('scenarioPanel');if(type==='baseline'){panel.innerHTML='<div class="hero"><span class="pill">Baseline</span><div class="big">'+money(state.revenue)+'</div><div>維持目前模型，不增加額外投入。</div></div>'}else{const isM=type==='marketing';panel.innerHTML='<div class="fields"><div class="field"><label>'+(isM?'行銷投入':'活動成本')+'</label><input id="sSpend" type="number" value="'+(isM?100000:50000)+'" min="0"></div><div class="field"><label>預估新增客</label><input id="sCust" type="number" value="'+(isM?300:200)+'" min="0"></div><div class="field"><label>新增客變動成本率</label><input id="sVar" type="number" value="45" min="0" max="100"></div></div><div id="sResult" class="result section"></div>';const update=()=>{const spend=val('sSpend'),c=val('sCust'),vr=val('sVar')/100,rev=c*state.ticket,variable=rev*vr,p=rev-variable-spend,bep=Math.ceil(spend/Math.max(1,state.ticket*(1-vr)));$('sResult').innerHTML='<div class="metric"><small>新增營收</small><strong>'+money(rev)+'</strong></div><div class="metric"><small>新增變動成本</small><strong>'+money(variable)+'</strong></div><div class="metric"><small>增量營業利益</small><strong class="'+(p>=0?'positive':'negative')+'">'+money(p)+'</strong></div><div class="metric"><small>損益平衡新增客</small><strong>'+num(bep)+' 人</strong></div>'};$('sSpend').oninput=update;$('sCust').oninput=update;$('sVar').oninput=update;update()}}
const inputs=['seats','open','close','weekdays','weekends','ticket','durationInput','wdPeakHours','wdPeakTurn','wdPeakFill','wdOffHours','wdOffTurn','wdOffFill','wePeakHours','wePeakTurn','wePeakFill','weOffHours','weOffTurn','weOffFill','fulltime','fullsalary','ptHours','ptRate','manager','managersalary','rent','utilities','other','foodRate','targetRevenue','targetTicket','mSpend','mCustomers','mTicket','mVarRate','mLaborExtra','mOtherExtra','actualRevenue','actualCustomers','actualFoodRate','actualLabor'];inputs.forEach(id=>{if($(id))$(id).addEventListener('input',calc)});document.querySelectorAll('[data-food]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-food]').forEach(x=>x.classList.remove('active'));b.classList.add('active');if(b.dataset.food==='custom')$('foodCustom').classList.remove('hide');else{$('foodCustom').classList.add('hide');foodRate=Number(b.dataset.food)}calc()});document.querySelectorAll('[data-meal]').forEach(b=>b.onclick=()=>{const k=b.dataset.meal;meals[k]=!meals[k];b.classList.toggle('active',meals[k]);calc()});document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.tab').forEach(x=>x.classList.add('hide'));$(b.dataset.tab).classList.remove('hide')});document.querySelectorAll('[data-scenario]').forEach(b=>b.onclick=()=>scenario(b.dataset.scenario));document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.mode;document.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('active',x===b));$('proPanel').classList.toggle('hide',mode!=='professional');calc()});calc();scenario('baseline');
</script>
</body></html>
